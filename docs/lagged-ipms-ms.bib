@article{oconnorLinkingPhysiologicalEffects2006,
  title = {Linking Physiological Effects on Activity and Resource Use to Population Level Phenomena},
  author = {O'Connor, Michael P. and Sieg, Annette E. and Dunham, Arthur E.},
  date = {2006-12-01},
  journaltitle = {Integrative and Comparative Biology},
  shortjournal = {Integrative and Comparative Biology},
  volume = {46},
